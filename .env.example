# Copy this file to `.env` and fill in real values before running the project.
# Never commit the real `.env` file to version control.

# A long, random, unpredictable string. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key

# Which settings module to load. Local dev tools (manage.py, wsgi.py,
# asgi.py) all default to config.settings.development if this is unset —
# only set this explicitly in production (see deploy/systemd/*.service).
# DJANGO_SETTINGS_MODULE=config.settings.production

# Set to False in production. Ignored by config.settings.production, which
# hardcodes DEBUG=False regardless — this only affects the development
# settings module.
DJANGO_DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve. Set this
# to your real domain(s) in production, e.g. shoporbit.example,www.shoporbit.example
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,shoporbit.example,www.shoporbit.example

# Origins allowed to POST here (login, checkout, etc.) despite a different
# Host header than the browser's address bar shows. Set to your real
# https://yourdomain in production; the ngrok defaults below are dev-only.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shoporbit.example,https://www.shoporbit.example

# Database configuration. Production/standard local dev is PostgreSQL;
# `postgres://user:password@host:5432/dbname` — see docs/infrastructure.md
# for local setup. `sqlite:///db.sqlite3` also works if you just need a
# quick throwaway environment (e.g. a one-off script), but isn't
# representative of the production database engine.
DATABASE_URL=postgres://shoporbit:change-me@localhost:5432/shoporbit

# Celery broker (Redis). See docs/infrastructure.md for running a worker locally.
CELERY_BROKER_URL=redis://localhost:6379/0

# Production-only: worker prefetch tuning (config.settings.production).
# Ignored entirely by config.settings.development.
# CELERY_WORKER_PREFETCH_MULTIPLIER=4

# How long a checkout can sit unpaid before its stock reservation is
# released and the order marked EXPIRED (see inventory/tasks.py).
RESERVATION_TIMEOUT_MINUTES=30

# How many days after delivery a buyer can request a return (see
# returns/services.py).
RETURN_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
# Delhivery — direct courier integration (see fulfillment/couriers/delhivery.py).
# Leave DELHIVERY_API_TOKEN blank to disable entirely (the default). Get the
# token and your pickup location's registered name once Delhivery API
# access is provisioned for your account.
# ---------------------------------------------------------------------------
DELHIVERY_API_TOKEN=
# DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION_NAME=
# DELHIVERY_DEFAULT_PACKAGE_WEIGHT_GRAMS=500

# ---------------------------------------------------------------------------
# Razorpay — the checkout payment gateway. Get keys from
# https://dashboard.razorpay.com/app/keys. Use test-mode keys (rzp_test_...)
# until you're ready to go live. RAZORPAY_WEBHOOK_SECRET is set when you
# create the webhook (Settings > Webhooks) pointed at
# https://yourdomain/payments/razorpay/webhook/ — it must match exactly
# what you enter in the Razorpay dashboard, not your API secret.
# ---------------------------------------------------------------------------
DEFAULT_PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Prefix for generated GST invoice numbers, e.g. INV -> INV/2025-26/000123.
INVOICE_SERIES_PREFIX=INV

# WhatsApp click-to-chat number, international format, digits only (no
# leading +, no spaces), e.g. 919876543210. Leave blank to derive it from
# COMPANY_PHONE instead.
WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Outbound email. Leave EMAIL_HOST blank to use the console backend (mail is
# printed to stdout instead of sent) — handy for local development. Fill
# these in with real SMTP credentials in production. EMAIL_BACKEND and
# EMAIL_TIMEOUT rarely need overriding — EMAIL_BACKEND auto-selects SMTP vs.
# console based on whether EMAIL_HOST is set.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Shop Orbit <no-reply@shoporbit.example>
# Staff mailbox CC'd on new orders and contact-form enquiries. Defaults to
# COMPANY_EMAIL below if left blank.
STAFF_NOTIFICATION_EMAIL=
# Where a customer's "Reply" on a transactional email lands. Defaults to
# COMPANY_EMAIL below if left blank; set to "" (empty) to omit the header.
# REPLY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Production-only settings (config.settings.production). All optional —
# every one of these has a safe default; see config/settings/production.py
# and docs/SECURITY.md for what each controls.
# ---------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS. Leave True once a real cert is live;
# only turn off temporarily if you're debugging behind a proxy without TLS.
# DJANGO_SECURE_SSL_REDIRECT=True

# HSTS: how long (seconds) browsers should refuse to connect over plain
# HTTP after their first HTTPS visit. Start low (e.g. 300) until you're
# confident HTTPS is solid site-wide, then raise to a year (31536000) —
# see docs/SECURITY.md for the recommended rollout.
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False

# Redis cache backend, kept on a different logical DB than the Celery
# broker above (DB 0) so cache eviction never touches queued tasks.
# REDIS_CACHE_URL=redis://:yourredispassword@localhost:6379/1

# Database connection reuse (seconds) and connect timeout.
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10

# Comma-separated name:email pairs that get emailed on uncaught server
# errors, e.g. "Jane Doe:jane@example.com,John Doe:john@example.com".
# DJANGO_ADMINS=

# ---------------------------------------------------------------------------
# Sentry error monitoring — https://sentry.io (or a self-hosted instance).
# Leave SENTRY_DSN blank to disable entirely (the default, e.g. for local
# dev); set it in production to start reporting uncaught Django exceptions,
# Celery task failures, and WARNING+ log records.
# ---------------------------------------------------------------------------
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Fraction (0.0-1.0) of requests/tasks to trace for performance monitoring.
# 0 (the default) reports errors only, no performance data — Sentry's
# performance tracing is a separate, paid-tier feature many plans don't
# include, so this stays off unless deliberately turned on.
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Site branding — drives the navbar, footer, admin, Privacy Policy, T&C, and
# every other reference to the storefront's name/domain across the site.
# ---------------------------------------------------------------------------
SITE_NAME=Shop Orbit
SITE_LEGAL_NAME=Shop Orbit
SITE_TAGLINE=Quality products, thoughtfully curated for every need.
SITE_DOMAIN=shoporbit.example
SITE_SCHEME=https

# Path to your logo file, relative to the static/ directory, e.g.
# img/logo.png (place the file at static/img/logo.png). Leave blank to show
# an auto-generated initials badge instead.
SITE_LOGO_PATH=

# Prefix for generated order numbers, e.g. ORD -> ORD38301240.
ORDER_NUMBER_PREFIX=ORD

# ---------------------------------------------------------------------------
# Company / contact details — shown in the header, footer, contact page,
# and legal pages.
# ---------------------------------------------------------------------------
COMPANY_ADDRESS_LINE1=221B Commercial Street
COMPANY_ADDRESS_LINE2=
COMPANY_CITY=Bengaluru
COMPANY_STATE=Karnataka
COMPANY_POSTAL_CODE=560001
COMPANY_COUNTRY=India
COMPANY_PHONE=+91 98765 43210
COMPANY_EMAIL=support@shoporbit.example
COMPANY_SUPPORT_HOURS=Mon–Sat, 10:00 AM – 7:00 PM IST
COMPANY_GST_NUMBER=

# Grievance officer — required for e-commerce entities under India's
# Consumer Protection (E-Commerce) Rules, 2020 and IT Rules, 2021. Leave
# blank until you have a real named officer; the Grievance section on the
# policy pages only renders once these are filled in.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_RESPONSE_DAYS=30

# Google Analytics 4 measurement ID (G-XXXXXXX) and Search Console
# verification code. Both optional — leave blank to skip; gtag.js and the
# verification meta tag only render once these are set.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# SEO defaults applied to every public page unless a page sets its own.
# ---------------------------------------------------------------------------
SEO_DEFAULT_TITLE=Shop Orbit — Online Store
SEO_DEFAULT_DESCRIPTION=Shop Orbit — quality products, thoughtfully curated. Browse our full catalog and shop online.
SEO_DEFAULT_KEYWORDS=online store, shopping, ecommerce, India
# Path relative to static/, e.g. img/og-default.jpg. Leave blank to omit.
SEO_DEFAULT_OG_IMAGE_PATH=
SEO_TWITTER_HANDLE=

# ---------------------------------------------------------------------------
# Django admin branding.
# ---------------------------------------------------------------------------
DJANGO_ADMIN_SITE_HEADER=Shop Orbit Admin
DJANGO_ADMIN_SITE_TITLE=Shop Orbit Admin Portal
